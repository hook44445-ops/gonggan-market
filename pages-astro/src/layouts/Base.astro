---
import { BIZ_ROWS, jsonLd } from '../lib/display.js';
const { title, description, canonical, image, schema=[], robots='index, follow' } = Astro.props;
const appId=String(import.meta.env.APP_STORE_ID || process.env.APP_STORE_ID || '').replace(/\D/g,'');
---
<!doctype html><html lang="ko"><head>
<meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/>
<title>{title}</title><meta name="description" content={description}/><meta name="robots" content={robots}/><link rel="canonical" href={canonical}/>
<meta property="og:type" content="website"/><meta property="og:site_name" content="공간랜드"/><meta property="og:locale" content="ko_KR"/>
<meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:url" content={canonical}/><meta property="og:image" content={image}/>
<meta name="twitter:card" content="summary_large_image"/><meta name="twitter:title" content={title}/><meta name="twitter:description" content={description}/><meta name="twitter:image" content={image}/>
{appId && <meta name="apple-itunes-app" content={'app-id='+appId+', app-argument='+canonical}/>}
{schema.length>0 && <script type="application/ld+json" set:html={jsonLd(schema)}/>}
</head><body><a class="skip" href="#content">본문으로</a><header><a href="https://gongganland.com/" aria-label="공간랜드 홈">← <strong>공간랜드</strong></a><span>우리 동네 시공 이야기</span></header>
<main id="content"><slot/></main><footer><strong>공간랜드 · 공간사이</strong><dl>{BIZ_ROWS.map(([label,value])=><div><dt>{label}</dt><dd>{value}</dd></div>)}</dl><a href="https://gongganland.com/">공간랜드 홈으로</a></footer>
</body></html>
<style is:global>
:root{--green:#0E2B1D;--ivory:#F4EFE4;--gold:#D6A756;--ink:#24362B;--muted:#5C695F;--line:rgba(214,167,86,.35);background:#F5F1EA;color:var(--ink);font-family:system-ui,-apple-system,'Apple SD Gothic Neo','Malgun Gothic',sans-serif;font-synthesis:none}*{box-sizing:border-box}body{margin:0}a{color:inherit}button{font:inherit;cursor:pointer}img{max-width:100%}header,main,footer{max-width:720px;margin:auto;padding:20px}header{display:flex;align-items:center;justify-content:space-between;gap:12px;font-size:14px}header a{text-decoration:none}header span{font-size:11px;color:var(--muted)}main{padding-top:0}h1{font-size:clamp(24px,5vw,32px);line-height:1.3;word-break:keep-all;margin:6px 0 0}h2{font-size:18px;margin:0 0 16px}p{line-height:1.75;overflow-wrap:anywhere}section{margin:34px 0}small,.muted{color:var(--muted);font-size:12px}.cover{position:relative;aspect-ratio:16/9;border-radius:22px;overflow:hidden;background:#E4E0D7}.cover img{width:100%;height:100%;object-fit:cover;display:block}.mood{position:absolute;right:10px;bottom:10px;border:1px solid var(--line);border-radius:20px;background:var(--green);color:var(--ivory);padding:5px 9px;font-size:11px}.hero{display:flex;align-items:center;gap:16px;margin:22px 0}.avatar{width:68px;height:68px;flex-shrink:0;display:grid;place-items:center;background:var(--green);color:var(--gold);font-size:30px;font-weight:800;border-radius:22px;overflow:hidden}.avatar img{width:100%;height:100%;object-fit:cover}.level{font-size:12px;font-weight:700;color:#356349}.temperature{font-size:12px;padding-left:12px;color:var(--muted)}.direct{font-size:12px;border:1px solid var(--line);padding:10px 12px;border-radius:12px;line-height:1.6}.trust{display:flex;gap:12px;margin:22px 0}.trust details{flex:1;text-align:center;font-size:11px}.trust summary{list-style:none;cursor:pointer}.trust summary::-webkit-details-marker{display:none}.trust img{display:block;margin:0 auto 5px;width:44px;height:44px}.locked img{filter:grayscale(1);opacity:.45}.trust p{position:relative;min-width:0;font-size:11px}.kpi{display:flex;gap:10px;margin:24px 0}.kpi div{flex:1;text-align:center;border-top:1px solid var(--line);border-bottom:1px solid var(--line);padding:14px 4px}.kpi b{display:block;font-size:24px}.kpi span{font-size:12px;color:var(--muted)}.tags{display:flex;flex-wrap:wrap;gap:8px}.tag{border:1px solid #DCDDD4;background:#FFFDF8;padding:7px 12px;border-radius:20px;font-size:12px}.empty{text-align:center;border:1px solid var(--line);border-radius:20px;padding:24px 16px}.empty img{border-radius:18px;width:88px;height:88px;display:block;margin:0 auto 14px}.empty strong{font-size:14px}.empty p{font-size:12px;margin-bottom:0}.works{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:8px}.work{margin:0;min-width:0}.work:first-child{grid-column:1/-1}.work a{display:block;border-radius:15px;overflow:hidden;aspect-ratio:1;background:#E4E0D7}.work:first-child a{aspect-ratio:16/10}.work img{width:100%;height:100%;object-fit:cover;display:block}.work figcaption{font-size:11px;line-height:1.5;margin:7px 0 10px;overflow-wrap:anywhere}.review{border-bottom:1px solid var(--line);padding:18px 0}.review p{margin:8px 0;font-size:14px;white-space:pre-wrap}.stars{color:#806020;font-size:13px;letter-spacing:2px}.review summary{cursor:pointer;line-height:1.7;font-size:14px;overflow-wrap:anywhere}.review .preview{display:block}.review details[open] .preview{display:none}.review img{width:80px;height:80px;border-radius:10px;object-fit:cover}.review-photos{display:flex;gap:8px;flex-wrap:wrap;margin-top:12px}.text-link{display:inline-block;padding:12px 0;line-height:1.6}.cta{position:fixed;z-index:10;bottom:0;left:0;right:0;padding:12px 20px calc(12px + env(safe-area-inset-bottom));background:rgba(245,241,234,.98);border-top:1px solid var(--line)}.cta a{display:block;max-width:680px;margin:auto;padding:17px 10px;background:var(--green);color:#fff;text-align:center;border-radius:15px;text-decoration:none;font-weight:750;font-size:15px}.install{padding:10px 14px;background:#E8EDDF;display:flex;align-items:center;gap:14px;border-radius:12px;margin:0 0 14px;font-size:13px}.install[hidden]{display:none}.install button{margin-left:auto;border:0;background:none;min-width:44px;min-height:44px}.error{padding:60px 0;text-align:center}.skip{position:absolute;left:-9999px}.skip:focus{left:12px;top:12px;z-index:40;background:#fff;padding:12px}:focus-visible{outline:3px solid #996800;outline-offset:4px}footer{padding-top:30px;padding-bottom:130px;border-top:1px solid var(--line);font-size:12px;color:var(--muted)}footer dl{font-size:11px;line-height:1.8}footer dl div{display:flex;gap:10px}footer dt{min-width:90px}footer dd{margin:0;overflow-wrap:anywhere}dialog{border:0;border-radius:16px;padding:16px;max-width:95vw;background:#F5F1EA}dialog::backdrop{background:#000b}dialog img{display:block;max-height:75vh;width:auto;margin:auto}dialog button{display:block;margin:0 0 12px auto;padding:10px 18px;min-height:44px}body:has(dialog[open]){overflow:hidden}
</style>
<style is:global>
/* Long portfolios and the legal footer need layout only as they approach the viewport. */
section, footer { content-visibility: auto; contain-intrinsic-size: auto 360px; }
/* Prefer the platform's Korean face, avoiding per-glyph fallback from Latin UI fonts. */
:root { font-family: 'Apple SD Gothic Neo', 'Malgun Gothic', system-ui, sans-serif; }
</style>
