---
import Empty from './Empty.astro';
import {stars,safeImage} from '../lib/display.js';
const {reviews,stats,external=[],externalCount=0,ref}=Astro.props;
---
<section><h2>시공 후기 {stats.count>0 && <small>{stats.average && '★ '+stats.average+' · '}{stats.count}건</small>}</h2>{reviews.length ? reviews.map(r=><article class="review"><div class="stars" aria-label={'별점 '+r.rating+'점'}>{stars(r.rating)}</div>{String(r.content || '').length>180 ? <details><summary><span class="preview">{String(r.content).slice(0,150)}…</span>후기 전체 읽기</summary><p>{r.content}</p></details>:<p>{r.content}</p>}<small>{[r.space_type,r.user_name].filter(Boolean).join(' · ')}</small>{Array.isArray(r.image_urls) && <div class="review-photos">{r.image_urls.map(safeImage).filter(Boolean).slice(0,3).map(url=><a href={url}><img src={url} alt="후기 사진" width="80" height="80" loading="lazy"/></a>)}</div>}</article>) : <Empty kind="review"/>}</section>
<section><h2>공간랜드 밖 공사 후기 {externalCount>0 && <small>{externalCount}건</small>}</h2><p class="muted">계약 기록이 없는 후기예요 · 평점과 공간온도에는 들어가지 않아요</p>{external.map(r=><article class="review"><div class="stars" aria-label={'이 후기의 별점 '+r.rating+'점'}>{stars(r.rating)}</div><p>{r.content}</p><small>{[r.work_title,r.author_name].filter(Boolean).join(' · ')}</small></article>)}<a class="text-link" href={'https://gongganmarket.com/p/'+encodeURIComponent(ref)+'?write=1&app=1'}>이 업체와 공사해 봤어요 · 후기 남기기 →</a></section>
