{
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/api/cron/autonomous-cycle", "destination": "/api/trend/check-trends?mode=autonomous" },
    { "source": "/sitemap.xml", "destination": "/api/sitemap" },
    { "source": "/robots.txt", "destination": "/api/robots" },
    { "source": "/llms.txt", "destination": "/api/prerender?page=llms" },
    {
      "source": "/",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*([Bb][Oo][Tt]|[Cc]rawl|[Ss]pider|[Ss]lurp|facebookexternalhit|Facebot|WhatsApp|kakaotalk|kakaostory|[Yy]eti|Daum|Pinterest|vkShare|Embedly|Quora|W3C_Validator|ia_archiver|Google-InspectionTool|ChatGPT-User|Claude-User|Perplexity-User|meta-externalagent).*"
        }
      ],
      "missing": [
        { "type": "query", "key": "app" }
      ],
      "destination": "/api/prerender?page=home"
    },
    {
      "source": "/partner",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*([Bb][Oo][Tt]|[Cc]rawl|[Ss]pider|[Ss]lurp|facebookexternalhit|Facebot|WhatsApp|kakaotalk|kakaostory|[Yy]eti|Daum|Pinterest|vkShare|Embedly|Quora|W3C_Validator|ia_archiver|Google-InspectionTool|ChatGPT-User|Claude-User|Perplexity-User|meta-externalagent).*"
        }
      ],
      "missing": [
        { "type": "query", "key": "app" }
      ],
      "destination": "/api/prerender?page=partner"
    },
    {
      "source": "/lounge/:path*",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*([Bb][Oo][Tt]|[Cc]rawl|[Ss]pider|[Ss]lurp|facebookexternalhit|Facebot|WhatsApp|kakaotalk|kakaostory|[Yy]eti|Daum|Pinterest|vkShare|Embedly|Quora|W3C_Validator|ia_archiver|Google-InspectionTool|ChatGPT-User|Claude-User|Perplexity-User|meta-externalagent).*"
        }
      ],
      "missing": [
        { "type": "query", "key": "app" }
      ],
      "destination": "/api/prerender?path=:path*"
    },
    { "source": "/((?!api/|naver0b2e655f5bb483edebab3e18bc7faf4712328734\\.html|naverdd7f227f04689ae77e06293315940389\\.html).*)", "destination": "/index.html" }
  ],
  "functions": {
    "api/trend/check-trends.js": { "maxDuration": 60 }
  },
  "crons": [
    { "path": "/api/push/dispatch", "schedule": "0 9 * * *" },
    { "path": "/api/trend/check-trends", "schedule": "0 6 * * *" }
  ]
}
