<?xml version="1.0" encoding="utf-8"?>
<!-- 공간마켓 런처 아이콘 앞면 — 앱 아이콘 v4(지붕 아래 견적 두 장).
     도형 원본: public/icons/gm-icon-v4.svg (1024 그리드) · 같은 좌표를 그대로 옮겼다.

     1024 그리드 → 108dp 어댑티브 화면. 내용을 0.88 로 줄여 어떤 마스크(원·스퀘어클)로
     잘려도 살아남게 한다 — public/icons/gm-icon-v4-maskable.svg 와 같은 비율이다.
       scale = (108/1024) * 0.88 = 0.0928
       translate = 54 - 0.0928 * 512 = 6.49   (그림 중심 512,512.25 를 54dp 에 놓는다)
     결과적으로 그림 폭이 108dp 중 약 65% 를 차지한다 — v3 과 같은 크기감이다. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:scaleX="0.0928"
        android:scaleY="0.0928"
        android:translateX="6.49"
        android:translateY="6.46">
        <!-- 지붕 -->
        <path android:strokeColor="#F4EFE4" android:strokeWidth="77" android:fillColor="#00000000"
            android:strokeLineCap="round" android:strokeLineJoin="round"
            android:pathData="M171,457 L512,252 L853,457"/>
        <!-- 뒷장(아이보리) -->
        <path android:fillColor="#F4EFE4"
            android:pathData="M237,474 H492 A26,26 0 0 1 518,500 V772 A26,26 0 0 1 492,798 H237 A26,26 0 0 1 211,772 V500 A26,26 0 0 1 237,474 Z"/>
        <!-- 앞장(골드) — 테두리 26 은 «위에 얹혀 있다»는 두께감 -->
        <path android:fillColor="#D6A756" android:strokeColor="#17472F" android:strokeWidth="26"
            android:pathData="M519,525 H814 A26,26 0 0 1 840,551 V772 A26,26 0 0 1 814,798 H519 A26,26 0 0 1 493,772 V551 A26,26 0 0 1 519,525 Z"/>
    </group>
</vector>
